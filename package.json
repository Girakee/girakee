{
  "name": "girakee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "admin",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev -w girakee-server",
    "dev:admin": "npm run dev -w girakee-admin",
    "build": "npm run generate:sitemap && tsc && vite build",
    "build:admin": "npm run build -w girakee-admin",
    "build:all": "npm run build && npm run build:admin",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  }
}
